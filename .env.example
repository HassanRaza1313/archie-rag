# Copy to .env (./scripts/rag.sh setup does this). Infrastructure only: chatbot settings live in the app.
# Local runs read every RAG_* value. Docker reads only the ones marked [docker]; paths inside containers are fixed.

# --- Where things run ---------------------------------------------------------
# Vector database: "embedded" (no Docker, small corpora) or "server" (Docker Qdrant: HNSW, payload indexes).
RAG_QDRANT_MODE=embedded
RAG_QDRANT_URL=http://localhost:6333
# Model servers. In Docker, host Ollama is reached at host.docker.internal.           [docker]
RAG_OLLAMA_URL=http://localhost:11434
# Any OpenAI-compatible server (OpenAI, LM Studio, vLLM, llama.cpp).                   [docker]
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
# Cross-encoder reranking: fastembed (CPU, ONNX) or none.                              [docker]
RAG_RERANK_PROVIDER=fastembed

# --- Data ---------------------------------------------------------------------
# Folders a chatbot may index (comma-separated). Local runs only.
RAG_DATA_ROOTS=data/sources
# Host folder mounted read-only at /data/sources in Docker.                            [docker]
RAG_SOURCES_HOST_DIR=../data/sources
RAG_STATE_DIR=.ragkit
RAG_MAX_UPLOAD_MB=100

# --- Server and security ------------------------------------------------------
RAG_BIND_HOST=127.0.0.1
RAG_PORT=8000
# Required whenever the API is reachable beyond this machine.                         [docker]
RAG_API_KEY=
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RAG_LOG_FORMAT=text
RAG_LOG_LEVEL=INFO

# --- Service level objectives (Telemetry screen, /api/slo; mirror changes in deploy/observability/rules.yml) ----
RAG_SLO_AVAILABILITY=0.99
RAG_SLO_LATENCY_TARGET=0.95
RAG_SLO_LATENCY_SECONDS=5
RAG_SLO_WINDOW_DAYS=7

# --- Docker -------------------------------------------------------------------
# Host interface for published ports; keep 127.0.0.1 unless you set RAG_API_KEY.
RAG_PUBLISH_HOST=127.0.0.1
RAG_UI_PORT=8080
RAG_API_PORT=8000
RAG_PROMETHEUS_PORT=9090
# Models pulled by `rag up --with-ollama` / `rag models pull`.
RAG_PULL_MODELS="nomic-embed-text qwen3.5:9b"
# Build the image with OCR support (adds ~200 MB).
RAG_INSTALL_OCR=false
# Prebuilt images for `rag up --release`.
RAG_IMAGE_OWNER=
RAG_VERSION=latest
