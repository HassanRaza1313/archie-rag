# Rendered by the nginx image's envsubst step; ${RAG_API_UPSTREAM} points at the API container.

# HTTPS ends at the proxy in front (Caddy); pass its scheme on so the API marks sign-in cookies Secure.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

# Share links and invitations carry their credential in the path: keep it out of the access log.
map $request_uri $loggable_uri {
    ~^(?<head>/(?:api/(?:auth/)?)?(?:share|invite)/)[^/?]+(?<tail>.*)$ $head[token]$tail;
    default $request_uri;
}
log_format redacted '$remote_addr [$time_local] "$request_method $loggable_uri $server_protocol" $status '
                    '$body_bytes_sent "$http_user_agent"';

server {
    access_log /var/log/nginx/access.log redacted;
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 100m;
    server_tokens off;

    # The visitor's address for rate limits: believe X-Forwarded-For only from private networks (the HTTPS
    # proxy and Docker), then pass on that one address so a visitor can't claim to be someone else.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Streams (chat tokens, build progress) must not be buffered.
    location /api/ {
        # shortcut: the name resolves once at start, to every API replica; restart ui after changing RAG_API_REPLICAS.
        proxy_pass ${RAG_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }

    # Shared chatbots may be embedded in any website (the widget); every other page stays unframeable.
    location /share/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors *" always;
        expires epoch;
        try_files /index.html =404;
    }

    location /assets/ {
        # expires, not add_header: an add_header here would drop the server-level security headers.
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires epoch;
        try_files $uri /index.html;
    }
}
